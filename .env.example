# ─── Butterbase (backend: DB + AI model gateway) ──────────────────────────
# App "reincarnation" already provisioned (app_7vvljeaymuzm). Tables + public
# access + default model are configured. You still need the keys below.
BUTTERBASE_APP_ID=app_7vvljeaymuzm
BUTTERBASE_API_URL=https://api.butterbase.ai
# Anon key (used by the @butterbase/sdk for table reads/writes)
BUTTERBASE_ANON_KEY=
# Personal API key with the ai:gateway scope (starts bb_sk_...) — used for the gateway
BUTTERBASE_SERVICE_KEY=bb_sk_xxxxxxxx
# Valid gateway model id (confirmed available)
BUTTERBASE_MODEL=anthropic/claude-sonnet-4.6

# ─── XTrace (memory: per-commentator style notes, self-revising) ──────────
# app.xtrace.ai → API key (starts xtk_...) + org id
XTRACE_API_KEY=xtk_xxxxxxxx
XTRACE_ORG_ID=
XTRACE_BASE_URL=https://api.production.xtrace.ai

# ─── RocketRide (AI pipeline engine) ──────────────────────────────────────
# docker run ... -p 5565:5565 ghcr.io/rocketride-org/rocketride-engine:latest
ROCKETRIDE_URL=http://localhost:5565
ROCKETRIDE_PIPELINE=reimagine
# If true, skip RocketRide and run the two LLM steps directly against the
# Butterbase gateway (fallback so the demo always works). Set false once the
# .pipe is wired up in the VS Code extension.
ROCKETRIDE_FALLBACK=true

# ─── Photon / Spectrum (iMessage delivery) ────────────────────────────────
# app.photon.codes → project settings
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
