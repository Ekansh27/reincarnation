# ─── Supabase (database) ──────────────────────────────────────────────────
# supabase.com → create project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key (server-side; bypasses RLS)

# ─── Anthropic (LLM, called directly) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── XTrace (memory: per-commentator style notes, self-revising) ──────────
XTRACE_API_KEY=xtk_xxxxxxxx
XTRACE_ORG_ID=
XTRACE_BASE_URL=https://api.production.xtrace.ai

# ─── RocketRide (optional AI pipeline engine; fallback runs steps directly) ─
ROCKETRIDE_URL=http://localhost:5565
ROCKETRIDE_PIPELINE=reimagine
ROCKETRIDE_FALLBACK=true

# ─── Photon / Spectrum (iMessage delivery) ────────────────────────────────
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# ─── ElevenLabs (TTS — cloned Harsha Bhogle voice) ────────────────────────
ELEVENLABS_API_KEY=             # elevenlabs.io → Profile → API Keys
ELEVENLABS_VOICE_ID=            # Voices → your cloned voice → voice_id
